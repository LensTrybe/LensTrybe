{
  "redirects": [
    {
      "source": "/edit",
      "destination": "/blog/edit",
      "statusCode": 301
    },
    {
      "source": "/the-trybe-edit",
      "destination": "/blog/edit",
      "statusCode": 301
    },
    {
      "source": "/the-trybe-edit/:path*",
      "destination": "/blog/edit",
      "statusCode": 301
    },
    {
      "source": "/trybe-edit",
      "destination": "/blog/edit",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/tour",
      "destination": "/api/render"
    },
    {
      "source": "/sitemap-creatives.xml",
      "destination": "https://lqafxisymvrazipaozfk.supabase.co/functions/v1/sitemap?type=creatives"
    },
    {
      "source": "/sitemap-edit.xml",
      "destination": "https://lqafxisymvrazipaozfk.supabase.co/functions/v1/sitemap?type=edit"
    },
    {
      "source": "/sitemap-local.xml",
      "destination": "https://lqafxisymvrazipaozfk.supabase.co/functions/v1/sitemap?type=local"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sitemap-creatives.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sitemap-edit.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sitemap-local.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ],
  "functions": {
    "api/render.js": {
      "includeFiles": "api/shell.html"
    }
  }
}
