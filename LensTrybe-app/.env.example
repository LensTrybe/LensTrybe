# Copy to .env and fill with values from your Supabase project (Settings → API).
# https://supabase.com/dashboard

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Revolut Merchant checkout (publishable key — safe in frontend)
# Use the SANDBOX pk_ while testing; swap to the production pk_ at go-live.
VITE_REVOLUT_PUBLIC_KEY=pk_your-revolut-public-key
VITE_REVOLUT_ENV=sandbox
