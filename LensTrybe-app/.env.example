# Copy to .env.local and fill in. .env.local is ignored by git; never commit a key.
# Values come from the live app's .env (same Supabase project, same Revolut sandbox key).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Revolut Merchant checkout, publishable key (safe in the browser). Sandbox until launch.
VITE_REVOLUT_PUBLIC_KEY=pk_your-revolut-public-key
VITE_REVOLUT_ENV=sandbox

# Leave unset for live. Set to "demo" to force the sample store even with keys present.
# VITE_LT_MODE=demo
